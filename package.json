{
  "name": "forseti-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small, evidence-first personal LLM benchmarks with a Pi-powered TUI",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node src/cli.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:terminal": "PYTHONDONTWRITEBYTECODE=1 python3 tests/terminal.py",
    "test:suite": "PYTHONDONTWRITEBYTECODE=1 node suites/personal/private/verify-controls.mjs",
    "test:judge": "PYTHONDONTWRITEBYTECODE=1 node suites/personal/private/verify-judge.mjs",
    "demo": "node src/cli.ts run --models control-reference,control-baseline --repeat 2",
    "doctor": "node src/cli.ts doctor",
    "screenshot": "node tools/screenshot.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
